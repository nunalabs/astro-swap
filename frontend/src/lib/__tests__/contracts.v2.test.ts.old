/**
 * AstroSwap Contracts V2 - Comprehensive Unit Tests
 *
 * Testing Strategy:
 * 1. Function signatures (correct parameter order)
 * 2. Deadline enforcement (MEV protection - M2 fix)
 * 3. Parameter validation
 * 4. Error handling
 * 5. Optimized getAmountsOut (parallel fetching)
 */

import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import * as StellarSdk from '@stellar/stellar-sdk';
import {
  swapExactTokensForTokens,
  addLiquidity,
  removeLiquidity,
  getAmountsOut,
  CONTRACTS,
} from '../contracts';
import * as stellar from '../stellar';

// Mock dependencies
vi.mock('../stellar', () => ({
  buildAndSubmitTransaction: vi.fn(),
  callContract: vi.fn(),
  sorobanServer: {
    getLatestLedger: vi.fn().mockResolvedValue({ sequence: 1000000 }),
  },
}));

// Test constants
const MOCK_USER = 'GAYES36VZUWL437CC2IIJ7OUCWYWESEOJ6GITMTCHEF6OOYWIUNBKVXI';
const MOCK_XLM = 'CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC';
const MOCK_ASTRO = 'CCHNAJAEDXSLXO4MBMSEX4ERTPDU2RC3JEQ25GGSXMGIIWMFZ3KWU2AS';
const MOCK_USDC = 'CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA';
const MOCK_PAIR = 'CC2VB6TA62WWA6Q2DJ57J4IIV64JQCZQM7BUJK7BBSTIBCR67IG2FBYP';

describe('AstroSwap Contracts V2', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  describe('swapExactTokensForTokens - V2 Signature Compliance', () => {
    it('should call contract with correct parameter order', async () => {
      // Arrange
      const amountIn = '1000000000'; // 100 XLM
      const amountOutMin = '800000000'; // 80 ASTRO (minimum)
      const path = [MOCK_XLM, MOCK_ASTRO];
      const deadline = Math.floor(Date.now() / 1000) + 300;

      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('mock-tx-hash');

      // Act
      await swapExactTokensForTokens(
        amountIn,
        amountOutMin,
        path,
        MOCK_USER,
        deadline,
        MOCK_USER
      );

      // Assert
      expect(mockContractCall).toHaveBeenCalledWith(
        'swap_exact_tokens_for_tokens',
        expect.anything(), // user (ScVal)
        expect.anything(), // amount_in (ScVal)
        expect.anything(), // amount_out_min (ScVal)
        expect.anything(), // path (ScVal)
        expect.anything()  // deadline (ScVal)
      );

      // Verify parameters are in correct order
      const callArgs = mockContractCall.mock.calls[0];
      expect(callArgs[0]).toBe('swap_exact_tokens_for_tokens');
      // user, amount_in, amount_out_min, path, deadline
      expect(callArgs).toHaveLength(6); // function name + 5 params
    });

    it('should enforce deadline parameter (M2 fix validation)', async () => {
      // Arrange
      const now = Math.floor(Date.now() / 1000);
      const deadline = now + 300; // 5 minutes

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      // Act
      await swapExactTokensForTokens(
        '1000000000',
        '800000000',
        [MOCK_XLM, MOCK_ASTRO],
        MOCK_USER,
        deadline,
        MOCK_USER
      );

      // Assert - deadline must be passed to contract
      expect(stellar.buildAndSubmitTransaction).toHaveBeenCalled();

      // Verify deadline is within expected range (5 minutes ± 1 second tolerance)
      const expectedDeadlineMin = now + 299;
      const expectedDeadlineMax = now + 301;
      expect(deadline).toBeGreaterThanOrEqual(expectedDeadlineMin);
      expect(deadline).toBeLessThanOrEqual(expectedDeadlineMax);
    });

    it('should handle multi-hop path (3+ tokens)', async () => {
      // Arrange
      const multiHopPath = [MOCK_XLM, MOCK_ASTRO, MOCK_USDC];
      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      // Act
      await swapExactTokensForTokens(
        '1000000000',
        '700000000',
        multiHopPath,
        MOCK_USER,
        Math.floor(Date.now() / 1000) + 300,
        MOCK_USER
      );

      // Assert - path should contain 3 tokens
      const callArgs = mockContractCall.mock.calls[0];
      const pathScVal = callArgs[4]; // path is 5th parameter (index 4)

      // Verify path is properly encoded as ScVec with 3 addresses
      expect(pathScVal).toBeDefined();
    });

    it('should throw error if path is empty', async () => {
      // Arrange
      const emptyPath: string[] = [];

      // Act & Assert
      await expect(
        swapExactTokensForTokens(
          '1000000000',
          '800000000',
          emptyPath,
          MOCK_USER,
          Math.floor(Date.now() / 1000) + 300,
          MOCK_USER
        )
      ).rejects.toThrow();
    });

    it('should encode amounts as i128 (not u128)', async () => {
      // This test verifies that amounts are encoded with correct type
      // i128 is required for Soroban token amounts

      const mockNativeToScVal = vi.spyOn(StellarSdk, 'nativeToScVal');
      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      await swapExactTokensForTokens(
        '1000000000',
        '800000000',
        [MOCK_XLM, MOCK_ASTRO],
        MOCK_USER,
        Math.floor(Date.now() / 1000) + 300,
        MOCK_USER
      );

      // Assert - check that amounts use i128 type
      const i128Calls = mockNativeToScVal.mock.calls.filter(
        call => call[1]?.type === 'i128'
      );
      expect(i128Calls.length).toBeGreaterThanOrEqual(2); // amount_in and amount_out_min
    });
  });

  describe('addLiquidity - V2 Signature Compliance', () => {
    it('should call contract with all 8 parameters in correct order', async () => {
      // Arrange
      const params = {
        tokenA: MOCK_XLM,
        tokenB: MOCK_ASTRO,
        amountADesired: '10000000000',
        amountBDesired: '100000000000',
        amountAMin: '9500000000',
        amountBMin: '95000000000',
        deadline: Math.floor(Date.now() / 1000) + 300,
      };

      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      // Act
      await addLiquidity(
        params.tokenA,
        params.tokenB,
        params.amountADesired,
        params.amountBDesired,
        params.amountAMin,
        params.amountBMin,
        MOCK_USER,
        params.deadline,
        MOCK_USER
      );

      // Assert
      expect(mockContractCall).toHaveBeenCalledWith(
        'add_liquidity',
        expect.anything(), // user
        expect.anything(), // token_a
        expect.anything(), // token_b
        expect.anything(), // amount_a_desired
        expect.anything(), // amount_b_desired
        expect.anything(), // amount_a_min
        expect.anything(), // amount_b_min
        expect.anything()  // deadline
      );

      // Verify 9 arguments: function name + 8 params
      expect(mockContractCall.mock.calls[0]).toHaveLength(9);
    });

    it('should enforce deadline parameter (M2 fix validation)', async () => {
      // Arrange
      const now = Math.floor(Date.now() / 1000);
      const deadline = now + 300;

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      // Act
      await addLiquidity(
        MOCK_XLM,
        MOCK_ASTRO,
        '10000000000',
        '100000000000',
        '9500000000',
        '95000000000',
        MOCK_USER,
        deadline,
        MOCK_USER
      );

      // Assert - deadline must be within 5 minutes
      expect(deadline).toBeGreaterThanOrEqual(now + 299);
      expect(deadline).toBeLessThanOrEqual(now + 301);
    });

    it('should validate token addresses (must be C + 56 chars)', async () => {
      // Invalid token addresses should throw error or be validated
      const invalidTokenA = 'INVALID_ADDRESS';

      // This test verifies that the contract call is attempted
      // The contract itself will validate the addresses
      vi.mocked(stellar.buildAndSubmitTransaction).mockRejectedValue(
        new Error('Invalid address')
      );

      await expect(
        addLiquidity(
          invalidTokenA,
          MOCK_ASTRO,
          '1000000000',
          '10000000000',
          '950000000',
          '9500000000',
          MOCK_USER,
          Math.floor(Date.now() / 1000) + 300,
          MOCK_USER
        )
      ).rejects.toThrow();
    });

    it('should handle slippage protection (min amounts)', async () => {
      // Test that amountAMin and amountBMin are enforced
      const amountADesired = '10000000000';
      const amountBDesired = '100000000000';
      const slippageBps = 50; // 0.5%

      // Calculate expected min amounts (amount * 9950 / 10000)
      const expectedMinA = (BigInt(amountADesired) * 9950n) / 10000n;
      const expectedMinB = (BigInt(amountBDesired) * 9950n) / 10000n;

      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      await addLiquidity(
        MOCK_XLM,
        MOCK_ASTRO,
        amountADesired,
        amountBDesired,
        expectedMinA.toString(),
        expectedMinB.toString(),
        MOCK_USER,
        Math.floor(Date.now() / 1000) + 300,
        MOCK_USER
      );

      // Assert - verify min amounts are passed
      expect(mockContractCall).toHaveBeenCalled();
    });
  });

  describe('removeLiquidity - V2 Signature Compliance', () => {
    it('should call contract with all 7 parameters in correct order', async () => {
      // Arrange
      const params = {
        tokenA: MOCK_XLM,
        tokenB: MOCK_ASTRO,
        liquidity: '15810000000',
        amountAMin: '500000000',
        amountBMin: '4000000000',
        deadline: Math.floor(Date.now() / 1000) + 300,
      };

      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      // Act
      await removeLiquidity(
        params.tokenA,
        params.tokenB,
        params.liquidity,
        params.amountAMin,
        params.amountBMin,
        MOCK_USER,
        params.deadline,
        MOCK_USER
      );

      // Assert
      expect(mockContractCall).toHaveBeenCalledWith(
        'remove_liquidity',
        expect.anything(), // user
        expect.anything(), // token_a
        expect.anything(), // token_b
        expect.anything(), // liquidity
        expect.anything(), // amount_a_min
        expect.anything(), // amount_b_min
        expect.anything()  // deadline
      );

      // Verify 8 arguments: function name + 7 params
      expect(mockContractCall.mock.calls[0]).toHaveLength(8);
    });

    it('should encode liquidity as i128', async () => {
      // Verify LP token amount uses i128 type
      const mockNativeToScVal = vi.spyOn(StellarSdk, 'nativeToScVal');
      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      await removeLiquidity(
        MOCK_XLM,
        MOCK_ASTRO,
        '15810000000',
        '500000000',
        '4000000000',
        MOCK_USER,
        Math.floor(Date.now() / 1000) + 300,
        MOCK_USER
      );

      // Check liquidity parameter uses i128
      const i128Calls = mockNativeToScVal.mock.calls.filter(
        call => call[1]?.type === 'i128'
      );
      expect(i128Calls.length).toBeGreaterThanOrEqual(3); // liquidity + 2 min amounts
    });

    it('should enforce minimum amounts (slippage protection)', async () => {
      // If actual amounts < minimums, transaction should fail
      // This is enforced by the contract, we just verify params are passed

      const mockContractCall = vi.fn();
      vi.spyOn(StellarSdk, 'Contract').mockImplementation(() => ({
        call: mockContractCall,
      } as any));

      vi.mocked(stellar.buildAndSubmitTransaction).mockResolvedValue('tx-hash');

      const amountAMin = '500000000';
      const amountBMin = '4000000000';

      await removeLiquidity(
        MOCK_XLM,
        MOCK_ASTRO,
        '15810000000',
        amountAMin,
        amountBMin,
        MOCK_USER,
        Math.floor(Date.now() / 1000) + 300,
        MOCK_USER
      );

      expect(mockContractCall).toHaveBeenCalled();
    });
  });

  describe('getAmountsOut - OPTIMIZED (Parallel Fetching)', () => {
    beforeEach(() => {
      // Mock getPairAddress to return valid pairs
      vi.mocked(stellar.callContract).mockImplementation(
        async (contractId, method, args, sourceAddress) => {
          if (method === 'get_pair') {
            return MOCK_PAIR;
          }
          if (method === 'get_reserves') {
            return ['100000000000', '10000000000']; // [ASTRO, XLM]
          }
          if (method === 'token_0') {
            return MOCK_ASTRO;
          }
          return null;
        }
      );
    });

    it('should fetch pair addresses in parallel (Promise.all)', async () => {
      // Test that multiple pairs are fetched concurrently, not sequentially
      const path = [MOCK_XLM, MOCK_ASTRO, MOCK_USDC];
      const amountIn = '1000000000';

      const promiseAllSpy = vi.spyOn(Promise, 'all');

      await getAmountsOut(amountIn, path, MOCK_USER);

      // Verify Promise.all was used for parallel fetching
      expect(promiseAllSpy).toHaveBeenCalled();
      expect(promiseAllSpy.mock.calls.length).toBeGreaterThanOrEqual(2); // 2 parallel batches
    });

    it('should fetch reserves in parallel (Promise.all)', async () => {
      const path = [MOCK_XLM, MOCK_ASTRO];
      const amountIn = '1000000000';

      const promiseAllSpy = vi.spyOn(Promise, 'all');

      await getAmountsOut(amountIn, path, MOCK_USER);

      // Verify reserves are fetched in parallel
      expect(promiseAllSpy).toHaveBeenCalled();
    });

    it('should calculate amounts locally (no additional RPC calls)', async () => {
      // After fetching pair data, calculation should be local (no more callContract)
      const path = [MOCK_XLM, MOCK_ASTRO];
      const amountIn = '1000000000';

      const callContractSpy = vi.mocked(stellar.callContract);
      callContractSpy.mockClear();

      await getAmountsOut(amountIn, path, MOCK_USER);

      // Should have called: get_pair (1x), get_reserves + token_0 (2x) = 3 calls total
      // NOT: get_amount_out on contract (local calculation instead)
      expect(callContractSpy).toHaveBeenCalled();
    });

    it('should handle 3-hop path efficiently (2 batches, not 9 sequential)', async () => {
      // For path [A, B, C, D]:
      // - Batch 1: Fetch 3 pair addresses (parallel)
      // - Batch 2: Fetch 3 reserves + 3 token_0 (parallel)
      // - Local: Calculate 3 amounts (no RPC)
      // Total: 2 parallel batches = 6 calls (vs 9 sequential in naive impl)

      const path = [MOCK_XLM, MOCK_ASTRO, MOCK_USDC];
      const amountIn = '1000000000';

      const promiseAllSpy = vi.spyOn(Promise, 'all');

      await getAmountsOut(amountIn, path, MOCK_USER);

      // Verify only 2 Promise.all calls (2 parallel batches)
      expect(promiseAllSpy.mock.calls.length).toBe(2);
    });

    it('should return empty array if pair not found', async () => {
      // Mock pair not found
      vi.mocked(stellar.callContract).mockImplementation(
        async (contractId, method) => {
          if (method === 'get_pair') {
            return null; // Pair doesn't exist
          }
          return null;
        }
      );

      const path = [MOCK_XLM, 'INVALID_TOKEN'];
      const amountIn = '1000000000';

      const result = await getAmountsOut(amountIn, path, MOCK_USER);

      expect(result).toEqual([]);
    });

    it('should apply 0.3% fee (30 bps) to calculations', async () => {
      // Verify constant product formula with fee:
      // amountOut = (amountIn * reserveOut * 9970) / (reserveIn * 10000 + amountIn * 9970)

      const path = [MOCK_XLM, MOCK_ASTRO];
      const amountIn = '1000000000'; // 100 XLM

      const result = await getAmountsOut(amountIn, path, MOCK_USER);

      // result[0] = amountIn
      // result[1] = amountOut (with 0.3% fee applied)
      expect(result).toHaveLength(2);
      expect(result[0]).toBe(amountIn);
      expect(BigInt(result[1])).toBeLessThan(BigInt(amountIn) * 10n); // Less than 10:1 ratio due to fees
    });
  });

  describe('Contract Address Validation', () => {
    it('should have V2 contract addresses configured', () => {
      // Verify V2 addresses are set (not V1)
      expect(CONTRACTS.FACTORY).toBe('CCC2DJCAMGHPIU65HJNFH3IL33EXKF466R4ERAGWJ7MU7WMHT4EPYSPU');
      expect(CONTRACTS.ROUTER).toBe('CAMIB25ZL5VQX24QMNLE6EFNKVTEFKPWGPTQCEPCUSZ7GR3UHTTZBVWS');
      expect(CONTRACTS.STAKING).toBe('CBBHH5JJATIVHG4M7PVA25FOTKPNNKSKBBURLE3KIZNMQMYWFTTV6E5S');
      expect(CONTRACTS.AGGREGATOR).toBe('CD5WKAJEWRUM2GT74XJ5TKG2V5AUR2WDCVTPTDJIBLV3XWHUT24YXYW7');
      expect(CONTRACTS.BRIDGE).toBe('CA74JXBZDLIT2RQQTNHZL42BKJZFUVA4D6QF6COL5HT3IH6RE6DV2ZQQ');
    });

    it('should validate contract IDs start with C and are 56 chars', () => {
      const contracts = Object.values(CONTRACTS).filter(addr => addr !== '');

      for (const contractId of contracts) {
        expect(contractId).toMatch(/^C[A-Z2-7]{55}$/);
        expect(contractId.length).toBe(56);
      }
    });
  });
});
