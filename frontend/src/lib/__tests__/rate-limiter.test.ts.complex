/**
 * RateLimiter - Unit Tests
 *
 * Strategy: Test rate limiting, retry logic, exponential backoff
 * Coverage: Queue management, error handling, statistics
 */

import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { rpcLimiter, contractLimiter } from '../rate-limiter';

// Import class for testing (not exported, so we test via singletons)
// We'll test the public API through the singleton instances

describe('RateLimiter', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    vi.useFakeTimers();
  });

  afterEach(() => {
    vi.useRealTimers();
  });

  describe('Configuration', () => {
    it('should create rpcLimiter with correct defaults', () => {
      const stats = rpcLimiter.getStats();

      expect(stats.queueLength).toBe(0);
      expect(stats.processing).toBe(false);
      expect(stats.requestCount).toBe(0);
      expect(typeof stats.windowStart).toBe('number');
    });

    it('should create contractLimiter with correct defaults', () => {
      const stats = contractLimiter.getStats();

      expect(stats.queueLength).toBe(0);
      expect(stats.processing).toBe(false);
    });
  });

  describe('Execution', () => {
    it('should execute simple function successfully', async () => {
      const mockFn = vi.fn().mockResolvedValue('success');

      const promise = rpcLimiter.execute(mockFn);

      // Fast-forward to allow processing
      await vi.runAllTimersAsync();

      const result = await promise;

      expect(result).toBe('success');
      expect(mockFn).toHaveBeenCalledTimes(1);
    });

    it('should execute multiple functions in order', async () => {
      const results: number[] = [];

      const fn1 = vi.fn().mockResolvedValue(1);
      const fn2 = vi.fn().mockResolvedValue(2);
      const fn3 = vi.fn().mockResolvedValue(3);

      const promise1 = rpcLimiter.execute(fn1);
      const promise2 = rpcLimiter.execute(fn2);
      const promise3 = rpcLimiter.execute(fn3);

      await vi.runAllTimersAsync();

      results.push(await promise1);
      results.push(await promise2);
      results.push(await promise3);

      expect(results).toEqual([1, 2, 3]);
    });

    it('should add delay between requests (100ms)', async () => {
      const mockFn = vi.fn().mockResolvedValue('ok');

      const promise1 = rpcLimiter.execute(mockFn);
      const promise2 = rpcLimiter.execute(mockFn);

      // Process first request
      await vi.advanceTimersByTimeAsync(0);

      // Should have delay before second request
      expect(mockFn).toHaveBeenCalledTimes(1);

      // Advance by delay (100ms)
      await vi.advanceTimersByTimeAsync(100);

      // Now second request should be processed
      await vi.runAllTimersAsync();

      await promise1;
      await promise2;

      expect(mockFn).toHaveBeenCalledTimes(2);
    });
  });

  describe('Rate Limiting', () => {
    it('should enforce max requests per second', async () => {
      // rpcLimiter has maxRequestsPerSecond: 10
      const mockFn = vi.fn().mockResolvedValue('ok');

      // Queue 15 requests
      const promises = Array.from({ length: 15 }, () =>
        rpcLimiter.execute(mockFn)
      );

      // Initially queued
      expect(rpcLimiter.getQueueLength()).toBeGreaterThan(0);

      // Process all
      await vi.runAllTimersAsync();

      await Promise.all(promises);

      // All should complete eventually
      expect(mockFn).toHaveBeenCalledTimes(15);
    });

    it('should reset window after 1 second', async () => {
      const mockFn = vi.fn().mockResolvedValue('ok');

      // Execute requests
      const promise1 = rpcLimiter.execute(mockFn);

      await vi.advanceTimersByTimeAsync(100);
      await promise1;

      const stats1 = rpcLimiter.getStats();
      expect(stats1.requestCount).toBeGreaterThanOrEqual(0);

      // Advance time by 1 second (window reset)
      await vi.advanceTimersByTimeAsync(1000);

      const promise2 = rpcLimiter.execute(mockFn);
      await vi.runAllTimersAsync();
      await promise2;

      // Window should have reset
      const stats2 = rpcLimiter.getStats();
      expect(typeof stats2.requestCount).toBe('number');
    });
  });

  describe('Retry Logic', () => {
    it('should retry on rate limit error', async () => {
      let callCount = 0;
      const mockFn = vi.fn().mockImplementation(() => {
        callCount++;
        if (callCount < 3) {
          return Promise.reject(new Error('Rate limit exceeded'));
        }
        return Promise.resolve('success');
      });

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      const result = await promise;

      expect(result).toBe('success');
      expect(mockFn).toHaveBeenCalledTimes(3); // Initial + 2 retries
    });

    it('should retry on network error', async () => {
      let callCount = 0;
      const mockFn = vi.fn().mockImplementation(() => {
        callCount++;
        if (callCount < 2) {
          return Promise.reject(new Error('Network timeout'));
        }
        return Promise.resolve('success');
      });

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      const result = await promise;

      expect(result).toBe('success');
      expect(mockFn).toHaveBeenCalledTimes(2);
    });

    it('should retry on 5xx server error', async () => {
      let callCount = 0;
      const mockFn = vi.fn().mockImplementation(() => {
        callCount++;
        if (callCount < 2) {
          return Promise.reject(new Error('Server error 503'));
        }
        return Promise.resolve('success');
      });

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      const result = await promise;

      expect(result).toBe('success');
    });

    it('should NOT retry on 4xx client error', async () => {
      const mockFn = vi.fn().mockRejectedValue(new Error('Bad request 400'));

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      await expect(promise).rejects.toThrow('Bad request 400');
      expect(mockFn).toHaveBeenCalledTimes(1); // No retry
    });

    it('should stop retrying after max retries', async () => {
      // rpcLimiter has maxRetries: 3
      const mockFn = vi.fn().mockRejectedValue(new Error('Rate limit exceeded'));

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      await expect(promise).rejects.toThrow('Rate limit exceeded');

      // Initial + 3 retries = 4 total calls
      expect(mockFn).toHaveBeenCalledTimes(4);
    });
  });

  describe('Exponential Backoff', () => {
    it('should increase delay exponentially on retries', async () => {
      let callCount = 0;
      const mockFn = vi.fn().mockImplementation(() => {
        callCount++;
        if (callCount <= 3) {
          return Promise.reject(new Error('Network error'));
        }
        return Promise.resolve('success');
      });

      const consoleSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      await promise;

      // Check that delays increased (logged in console.warn)
      expect(consoleSpy).toHaveBeenCalled();

      // First retry: ~1000ms + jitter
      // Second retry: ~2000ms + jitter
      // Third retry: ~4000ms + jitter

      consoleSpy.mockRestore();
    });

    it('should cap delay at maxDelay', async () => {
      // Base delay: 1000ms
      // Max delay: 10000ms
      // After many retries, delay should not exceed 10000ms

      // This is implicitly tested by the calculateBackoff logic
      // We can't directly test private methods, but we can verify
      // that retries don't take excessively long

      let callCount = 0;
      const mockFn = vi.fn().mockImplementation(() => {
        callCount++;
        if (callCount <= 3) {
          return Promise.reject(new Error('timeout'));
        }
        return Promise.resolve('ok');
      });

      const promise = rpcLimiter.execute(mockFn);

      await vi.runAllTimersAsync();

      await promise;

      expect(mockFn).toHaveBeenCalled();
    });
  });

  describe('Queue Management', () => {
    it('should track queue length', () => {
      const mockFn = vi.fn().mockResolvedValue('ok');

      // Queue multiple requests
      rpcLimiter.execute(mockFn);
      rpcLimiter.execute(mockFn);
      rpcLimiter.execute(mockFn);

      const queueLength = rpcLimiter.getQueueLength();
      expect(queueLength).toBeGreaterThanOrEqual(0);
    });

    it('should process queue in FIFO order', async () => {
      const results: number[] = [];

      const promise1 = rpcLimiter.execute(() => {
        results.push(1);
        return Promise.resolve(1);
      });

      const promise2 = rpcLimiter.execute(() => {
        results.push(2);
        return Promise.resolve(2);
      });

      const promise3 = rpcLimiter.execute(() => {
        results.push(3);
        return Promise.resolve(3);
      });

      await vi.runAllTimersAsync();

      await Promise.all([promise1, promise2, promise3]);

      expect(results).toEqual([1, 2, 3]);
    });

    it('should move failed requests to front of queue for retry', async () => {
      const results: string[] = [];

      // First request fails once then succeeds
      let firstCallCount = 0;
      const firstFn = vi.fn().mockImplementation(() => {
        firstCallCount++;
        if (firstCallCount === 1) {
          results.push('first-fail');
          return Promise.reject(new Error('Network error'));
        }
        results.push('first-success');
        return Promise.resolve('first');
      });

      // Second request succeeds immediately
      const secondFn = vi.fn().mockImplementation(() => {
        results.push('second');
        return Promise.resolve('second');
      });

      const promise1 = rpcLimiter.execute(firstFn);
      const promise2 = rpcLimiter.execute(secondFn);

      await vi.runAllTimersAsync();

      await Promise.all([promise1, promise2]);

      // First request should fail, second executes, then first retries
      expect(results).toContain('first-fail');
      expect(results).toContain('second');
      expect(results).toContain('first-success');
    });
  });

  describe('Statistics', () => {
    it('should return current statistics', () => {
      const stats = rpcLimiter.getStats();

      expect(stats).toHaveProperty('queueLength');
      expect(stats).toHaveProperty('processing');
      expect(stats).toHaveProperty('requestCount');
      expect(stats).toHaveProperty('windowStart');

      expect(typeof stats.queueLength).toBe('number');
      expect(typeof stats.processing).toBe('boolean');
      expect(typeof stats.requestCount).toBe('number');
      expect(typeof stats.windowStart).toBe('number');
    });

    it('should update stats during processing', async () => {
      const mockFn = vi.fn().mockResolvedValue('ok');

      const statsBefore = rpcLimiter.getStats();
      expect(statsBefore.processing).toBe(false);

      const promise = rpcLimiter.execute(mockFn);

      // Stats may show processing=true during execution
      // (timing-dependent, so we just verify the structure)

      await vi.runAllTimersAsync();
      await promise;

      const statsAfter = rpcLimiter.getStats();
      expect(statsAfter.processing).toBe(false);
    });
  });

  describe('Error Types', () => {
    it('should identify rate limit errors as retryable', async () => {
      const errors = [
        new Error('Rate limit exceeded'),
        new Error('Too many requests'),
        new Error('RATE LIMIT violation'), // Case insensitive
      ];

      for (const error of errors) {
        let callCount = 0;
        const mockFn = vi.fn().mockImplementation(() => {
          callCount++;
          if (callCount === 1) {
            return Promise.reject(error);
          }
          return Promise.resolve('success');
        });

        const promise = rpcLimiter.execute(mockFn);
        await vi.runAllTimersAsync();
        await promise;

        expect(mockFn).toHaveBeenCalledTimes(2); // Retry happened
      }
    });

    it('should identify network errors as retryable', async () => {
      const errors = [
        new Error('Network timeout'),
        new Error('ECONNREFUSED'),
        new Error('ECONNRESET'),
      ];

      for (const error of errors) {
        let callCount = 0;
        const mockFn = vi.fn().mockImplementation(() => {
          callCount++;
          if (callCount === 1) {
            return Promise.reject(error);
          }
          return Promise.resolve('success');
        });

        const promise = rpcLimiter.execute(mockFn);
        await vi.runAllTimersAsync();
        await promise;

        expect(mockFn).toHaveBeenCalledTimes(2);
      }
    });

    it('should identify 5xx errors as retryable', async () => {
      const errors = [
        new Error('500 Internal Server Error'),
        new Error('502 Bad Gateway'),
        new Error('503 Service Unavailable'),
      ];

      for (const error of errors) {
        let callCount = 0;
        const mockFn = vi.fn().mockImplementation(() => {
          callCount++;
          if (callCount === 1) {
            return Promise.reject(error);
          }
          return Promise.resolve('success');
        });

        const promise = rpcLimiter.execute(mockFn);
        await vi.runAllTimersAsync();
        await promise;

        expect(mockFn).toHaveBeenCalledTimes(2);
      }
    });

    it('should NOT retry validation errors', async () => {
      const mockFn = vi.fn().mockRejectedValue(new Error('Invalid parameter'));

      const promise = rpcLimiter.execute(mockFn);
      await vi.runAllTimersAsync();

      await expect(promise).rejects.toThrow('Invalid parameter');
      expect(mockFn).toHaveBeenCalledTimes(1); // No retry
    });
  });

  describe('Different Limiters', () => {
    it('rpcLimiter and contractLimiter should be independent', async () => {
      const rpcFn = vi.fn().mockResolvedValue('rpc');
      const contractFn = vi.fn().mockResolvedValue('contract');

      const rpcPromise = rpcLimiter.execute(rpcFn);
      const contractPromise = contractLimiter.execute(contractFn);

      await vi.runAllTimersAsync();

      await Promise.all([rpcPromise, contractPromise]);

      expect(rpcFn).toHaveBeenCalledTimes(1);
      expect(contractFn).toHaveBeenCalledTimes(1);
    });
  });
});
