{
  "name": "astro-swap",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "astro-swap",
  "tags": ["scope:swap", "type:dex", "platform:stellar"],
  "implicitDependencies": ["astro-core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "echo 'Building astro-swap...'"
        ],
        "cwd": "astro-swap"
      },
      "dependsOn": ["build-contracts", "build-sdk", "build-frontend"],
      "outputs": [
        "{projectRoot}/frontend/dist",
        "{projectRoot}/sdk/dist",
        "{projectRoot}/target/wasm32-unknown-unknown/release"
      ],
      "cache": true
    },
    "build-contracts": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-factory",
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-pair",
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-router",
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-staking",
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-aggregator",
          "cargo build --target wasm32-unknown-unknown --release -p astroswap-bridge"
        ],
        "cwd": "astro-swap",
        "parallel": true
      },
      "outputs": ["{projectRoot}/target/wasm32-unknown-unknown/release"],
      "cache": true
    },
    "build-sdk": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "astro-swap/sdk"
      },
      "outputs": ["{projectRoot}/sdk/dist"],
      "cache": true
    },
    "build-frontend": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "astro-swap/frontend"
      },
      "dependsOn": ["build-sdk"],
      "outputs": ["{projectRoot}/frontend/dist"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "astro-swap/frontend"
      }
    },
    "dev:indexer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "astro-swap/indexer"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["test-contracts", "test-sdk", "test-frontend"],
      "options": {
        "command": "echo 'All tests passed'"
      },
      "cache": true
    },
    "test-contracts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --workspace",
        "cwd": "astro-swap"
      },
      "cache": true
    },
    "test-sdk": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "astro-swap/sdk"
      },
      "cache": true
    },
    "test-frontend": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "astro-swap/frontend"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["lint-rust", "lint-frontend", "lint-sdk"],
      "options": {
        "command": "echo 'Lint passed'"
      },
      "cache": true
    },
    "lint-rust": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --workspace -- -D warnings",
        "cwd": "astro-swap"
      },
      "cache": true
    },
    "lint-frontend": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "astro-swap/frontend"
      },
      "cache": true
    },
    "lint-sdk": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "astro-swap/sdk"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd frontend && pnpm typecheck",
          "cd sdk && pnpm typecheck"
        ],
        "cwd": "astro-swap",
        "parallel": true
      },
      "cache": true
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt --all",
          "cd frontend && pnpm lint --fix || true",
          "cd sdk && pnpm lint --fix || true"
        ],
        "cwd": "astro-swap",
        "parallel": false
      }
    },
    "optimize": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-contracts"],
      "options": {
        "command": "for wasm in target/wasm32-unknown-unknown/release/astroswap_*.wasm; do stellar contract optimize --wasm \"$wasm\" --wasm-out \"${wasm%.wasm}.optimized.wasm\" 2>/dev/null || true; done",
        "cwd": "astro-swap"
      },
      "outputs": ["{projectRoot}/target/wasm32-unknown-unknown/release/*.optimized.wasm"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clean",
          "rm -rf frontend/dist sdk/dist"
        ],
        "cwd": "astro-swap",
        "parallel": false
      }
    }
  }
}
